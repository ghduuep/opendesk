<% content_for :title, "Admin Dashboard · OpenDesk" %>

<div class="mx-auto max-w-7xl px-6 py-8">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900">
      Dashboard
    </h1>

    <p class="mt-1 text-sm text-gray-500">
      Overview of your support operation.
    </p>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm font-medium text-gray-500">
        Open
      </p>

      <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        <%= @open_count %>
      </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm font-medium text-gray-500">
        Pending
      </p>

      <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        <%= @pending_count %>
      </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm font-medium text-gray-500">
        Unassigned
      </p>

      <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        <%= @unassigned_count %>
      </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm font-medium text-gray-500">
        Urgent
      </p>

      <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        <%= @urgent_count %>
      </p>
    </div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <section class="rounded-xl border border-gray-200 bg-white">
      <div class="border-b border-gray-100 px-5 py-4">
        <h2 class="text-sm font-semibold text-gray-900">
          Ticket overview
        </h2>

        <p class="mt-1 text-sm text-gray-500">
          Tickets by current status.
        </p>
      </div>

      <div class="divide-y divide-gray-100">
        <% @ticket_counts.each do |status, count| %>
          <div class="flex items-center justify-between px-5 py-4">
            <span class="text-sm text-gray-600">
              <%= status.to_s.humanize %>
            </span>

            <span class="text-sm font-semibold text-gray-900">
              <%= count %>
            </span>
          </div>
        <% end %>
      </div>
    </section>

    <section class="rounded-xl border border-gray-200 bg-white">
      <div class="border-b border-gray-100 px-5 py-4">
        <h2 class="text-sm font-semibold text-gray-900">
          Team & customers
        </h2>

        <p class="mt-1 text-sm text-gray-500">
          People in your workspace.
        </p>
      </div>

      <div class="divide-y divide-gray-100">
        <div class="flex items-center justify-between px-5 py-4">
          <span class="text-sm text-gray-600">
            Agents
          </span>

          <span class="text-sm font-semibold text-gray-900">
            <%= @agents_count %>
          </span>
        </div>

        <div class="flex items-center justify-between px-5 py-4">
          <span class="text-sm text-gray-600">
            Admins
          </span>

          <span class="text-sm font-semibold text-gray-900">
            <%= @admins_count %>
          </span>
        </div>

        <div class="flex items-center justify-between px-5 py-4">
          <span class="text-sm text-gray-600">
            Customers
          </span>

          <span class="text-sm font-semibold text-gray-900">
            <%= @customers_count %>
          </span>
        </div>

        <div class="flex items-center justify-between px-5 py-4">
          <span class="text-sm text-gray-600">
            Contacts
          </span>

          <span class="text-sm font-semibold text-gray-900">
            <%= @contacts_count %>
          </span>
        </div>
      </div>
    </section>
  </div>

  <section class="mt-8">
    <div>
      <h2 class="text-base font-semibold text-gray-900">
        Recent tickets
      </h2>

      <p class="mt-1 text-sm text-gray-500">
        Latest activity in your support queue.
      </p>
    </div>

    <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 bg-white">
      <% if @recent_tickets.any? %>
        <div class="divide-y divide-gray-100">
          <% @recent_tickets.each do |ticket| %>
            <div class="flex items-center justify-between gap-6 px-5 py-4">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-gray-900">
                  <%= ticket.subject %>
                </p>

                <p class="mt-1 text-xs text-gray-500">
                  <%= ticket.requester&.display_name || "No requester" %>
                  ·
                  <%= time_ago_in_words(ticket.created_at) %> ago
                </p>
              </div>

              <div class="flex shrink-0 items-center gap-6">
                <div class="hidden text-right sm:block">
                  <p class="text-xs text-gray-400">
                    Assignee
                  </p>

                  <p class="mt-0.5 text-sm text-gray-600">
                    <%= ticket.assignee&.email_address || "Unassigned" %>
                  </p>
                </div>

                <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">
                  <%= ticket.status.humanize %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-6 py-12 text-center">
          <p class="text-sm font-medium text-gray-900">
            No tickets yet
          </p>

          <p class="mt-1 text-sm text-gray-500">
            Ticket activity will appear here.
          </p>
        </div>
      <% end %>
    </div>
  </section>
</div>
