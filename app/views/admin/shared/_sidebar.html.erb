<aside class="flex min-h-screen w-64 shrink-0 flex-col border-r border-gray-200 bg-white">
    <div class="flex h-16 items-center border-b border-gray-200 px-6">
        <%= link_to root_path, class: "text-lg font-semibold tracking-tight text-gray-900" do %>
        OpenDesk
        <% end %>
    </div>

    <nav class="flex-1 space-y-1 p-4">
        <%= link_to agent_tickets_path, class: "flex items-center rounded-lg px-3 py-2 text-sm font-medium hover:bg-gray-100 hover:text-gray-900" do %>
        Tickets
        <% end %>

        <%= link_to agent_contacts_path, class: "flex items-center rounded-lg px-3 py-2 text-sm font-medium hover:bg-gray-100 hover:text-gray-900" do %>
            Contacts
        <% end %>

        <%= link_to agent_knowledge_base_root_path, class: "flex items-center rounded-lg px-3 py-2 text-sm font-medium hover:bg-gray-100 hover:text-gray 900" do %>
            Knowledge base
        <% end %>

        <%= link_to admin_users_path, class: "flex items-center rounded-lg px-3 py-2 text-sm font-medium hover:bg-gray-100 hover:text-gray 900" do %>
          Team Members
        <% end %>
    </nav>

    <div class="border-t border-gray-200 p-4">
        <% if Current.user %>
            <p class="truncate text-sm font-medium text-gray-700">
                <%= Current.user.email_address %>
            </p>

            <p class="mt-1 truncate text-xs text-gray-500">
                <%= Current.account.name %>
            </p>
        <% end %>
    </div>
</aside>
