<% content_for :title, "Edit team member · OpenDesk" %>

<div class="mx-auto max-w-2xl px-6 py-10">
  <div>
    <%= link_to "← Team",
      admin_users_path,
      class: "text-sm text-gray-500 hover:text-gray-900" %>

    <h1 class="mt-4 text-2xl font-semibold text-gray-900">
      Edit team member
    </h1>

    <p class="mt-1 text-sm text-gray-500">
      Update this team member's details and access level.
    </p>
  </div>

  <%= form_with model: [:admin, @user], class: "mt-8 space-y-6" do |form| %>
    <% if @user.errors.any? %>
      <div class="rounded-lg border border-red-200 bg-red-50 p-4">
        <h2 class="text-sm font-medium text-red-800">
          We couldn't update this user.
        </h2>

        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :email_address,
        "Email address",
        class: "block text-sm font-medium text-gray-700" %>

      <%= form.email_field :email_address,
        required: true,
        autocomplete: "email",
        class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>

    <div>
      <%= form.label :role,
        "Role",
        class: "block text-sm font-medium text-gray-700" %>

      <%= form.select :role,
        [
          ["Agent", "agent"],
          ["Admin", "admin"]
        ],
        {},
        class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>

      <p class="mt-2 text-xs text-gray-500">
        Agents can work with tickets and customers. Admins can also manage the account and team.
      </p>
    </div>

    <div class="flex items-center justify-end gap-3 border-t border-gray-200 pt-6">
      <%= link_to "Cancel",
        admin_users_path,
        class: "rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>

      <%= form.submit "Save changes",
        class: "cursor-pointer rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
    </div>
  <% end %>
</div>
