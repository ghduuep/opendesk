<% content_for :title, "Team · OpenDesk" %>

<div class="mx-auto max-w-6xl px-6 py-10">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">
        Team
      </h1>

      <p class="mt-1 text-sm text-gray-500">
        Manage the people who have access to your workspace.
      </p>
    </div>

    <%= link_to "Add team member",
      new_admin_user_path,
      class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
  </div>

  <div class="mt-8 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
    <% if @users.any? %>
      <div class="divide-y divide-gray-100">
        <% @users.each do |user| %>
          <div class="flex items-center justify-between px-6 py-4">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-gray-900">
                <%= user.email_address %>
              </p>

              <% if user == Current.user %>
                <p class="mt-1 text-xs text-gray-500">
                  You
                </p>
              <% end %>
            </div>

            <div class="ml-4 flex items-center gap-4">
              <% if user.admin? %>
                <span class="inline-flex rounded-full bg-purple-50 px-2.5 py-1 text-xs font-medium text-purple-700">
                  Admin
                </span>
              <% else %>
                <span class="inline-flex rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700">
                  Agent
                </span>
              <% end %>

              <%= link_to "Edit",
                edit_admin_user_path(user),
                class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>

            <%= button_to admin_user_path(user), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this user?"}, class: "shrink-0 text-sm font-medium text-red-600 hover:text-red-700" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash preview-icon"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center">
        <p class="text-sm font-medium text-gray-900">
          No team members yet
        </p>

        <p class="mt-1 text-sm text-gray-500">
          Add an agent or administrator to your workspace.
        </p>

        <div class="mt-6">
          <%= link_to "Add team member",
            new_admin_user_path,
            class: "inline-flex rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
