<%= link_to agent_ticket_path(ticket),
  class: "flex items-center justify-between gap-6 px-5 py-4 transition hover:bg-gray-50" do %>

  <div class="min-w-0">
    <p class="truncate text-sm font-medium text-gray-900">
      <%= ticket.subject %>
    </p>

    <p class="mt-1 text-xs text-gray-500">
      <%= ticket.requester&.display_name || "No requester" %>
      ·
      <%= time_ago_in_words(ticket.created_at) %> ago
    </p>
  </div>

  <div class="flex shrink-0 items-center gap-3">
    <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">
      <%= ticket.priority.humanize %>
    </span>

    <span class="text-xs font-medium text-gray-500">
      <%= ticket.status.humanize %>
    </span>

    <span class="text-gray-400">
      →
    </span>
  </div>
<% end %>
