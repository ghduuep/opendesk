<% content_for :title, "Dashboard · OpenDesk" %>

<div class="mx-auto max-w-7xl px-6 py-8">
  <div class="flex items-start justify-between gap-6">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">
        Dashboard
      </h1>

      <p class="mt-1 text-sm text-gray-500">
        Here's what's happening with your support queue.
      </p>
    </div>

    <%= link_to new_agent_ticket_path,
      class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-gray-800" do %>
      New ticket
    <% end %>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm font-medium text-gray-500">
        Assigned to me
      </p>

      <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        <%= @assigned_to_me_count %>
      </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm font-medium text-gray-500">
        Unassigned
      </p>

      <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        <%= @unassigned_count %>
      </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm font-medium text-gray-500">
        Open
      </p>

      <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        <%= @open_count %>
      </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm font-medium text-gray-500">
        Urgent
      </p>

      <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        <%= @urgent_count %>
      </p>
    </div>
  </div>

  <div class="mt-8 grid gap-8 xl:grid-cols-2">
    <section>
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-base font-semibold text-gray-900">
            My tickets
          </h2>

          <p class="mt-1 text-sm text-gray-500">
            Active tickets assigned to you.
          </p>
        </div>

        <%= link_to "View all",
          agent_tickets_path(assignee_id: Current.user.id),
          class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
      </div>

      <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 bg-white">
        <% if @my_tickets.any? %>
          <div class="divide-y divide-gray-100">
            <%= render partial: "ticket_row",
              collection: @my_tickets,
              as: :ticket %>
          </div>
        <% else %>
          <div class="px-6 py-10 text-center">
            <p class="text-sm font-medium text-gray-900">
              You're all caught up
            </p>

            <p class="mt-1 text-sm text-gray-500">
              You don't have any active tickets assigned to you.
            </p>
          </div>
        <% end %>
      </div>
    </section>

    <section>
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-base font-semibold text-gray-900">
            Unassigned
          </h2>

          <p class="mt-1 text-sm text-gray-500">
            Tickets waiting for an agent.
          </p>
        </div>

        <%= link_to "View all",
          agent_tickets_path(assignee_id: "unassigned"),
          class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
      </div>

      <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 bg-white">
        <% if @unassigned_tickets.any? %>
          <div class="divide-y divide-gray-100">
            <%= render partial: "ticket_row",
              collection: @unassigned_tickets,
              as: :ticket %>
          </div>
        <% else %>
          <div class="px-6 py-10 text-center">
            <p class="text-sm font-medium text-gray-900">
              Queue is clear
            </p>

            <p class="mt-1 text-sm text-gray-500">
              There are no unassigned tickets right now.
            </p>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</div>
