<% content_for :title, "#{@article.title} · OpenDesk" %>

<div class="mx-auto max-w-3xl px-8 py-10">
  <%= link_to "← #{@article.category.name}",
    agent_knowledge_base_category_path(@article.category),
    class: "text-sm text-gray-500 hover:text-gray-900" %>

  <div class="mt-6 flex items-start justify-between gap-6">
    <div>
      <div class="mb-3">
        <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">
          <%= @article.status.humanize %>
        </span>
      </div>

      <h1 class="text-2xl font-semibold text-gray-900">
        <%= @article.title %>
      </h1>
    </div>

    <div class="flex items-center gap-6">
        <%= button_to agent_knowledge_base_article_path(@article), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this article?" }, class: "shrink-0 text-sm font-medium text-red-600 hover:text-red-700" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash preview-icon"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        <% end %>
        <%= link_to "Edit",
        edit_agent_knowledge_base_article_path(@article),
        class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
    </div>
  </div>

  <div class="mt-8 border-t border-gray-200 pt-8">
    <div class="whitespace-pre-wrap text-sm leading-7 text-gray-700"><%= @article.body %></div>
  </div>
</div>
