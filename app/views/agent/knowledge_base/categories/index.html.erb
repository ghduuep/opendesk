<% content_for :title, "Knowledge Base · OpenDesk" %>

<div class="mx-auto max-w-5xl px-8 py-10">
  <div class="flex items-start justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">
        Knowledge Base
      </h1>

      <p class="mt-1 text-sm text-gray-500">
        Create and organize help articles for your customers.
      </p>
    </div>

    <%= link_to "New category",
      new_agent_knowledge_base_category_path,
      class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
  </div>

  <div class="mt-8">
    <% if @categories.any? %>
      <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="divide-y divide-gray-100">
          <% @categories.each do |category| %>
            <%= link_to agent_knowledge_base_category_path(category), class: "flex items-center justify-between px-5 py-4 transition hover:bg-gray-50" do %>

              <div>
                <h2 class="text-sm font-medium text-gray-900">
                  <%= category.name %>
                </h2>

                <% if category.description.present? %>
                  <p class="mt-1 text-sm text-gray-500">
                    <%= category.description %>
                  </p>
                <% end %>
              </div>

              <div class="flex items-center gap-4">
                <span class="text-xs text-gray-400">
                  <%= pluralize(category.articles.count, "article") %>
                </span>

                <span class="text-gray-400">
                  →
                </span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-gray-300 px-6 py-12 text-center">
        <h2 class="text-sm font-medium text-gray-900">
          No categories yet
        </h2>

        <p class="mt-1 text-sm text-gray-500">
          Create your first category to start organizing articles.
        </p>
      </div>
    <% end %>
  </div>
</div>
