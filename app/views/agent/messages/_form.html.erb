<div class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <%= form_with model: [:agent, ticket, message] do |form| %>

    <% if message.errors.any? %>
        <div class="border-b border-red-100 bg-red-50 px-4 py-3">
            <% message.errors.full_messages.each do |error| %>
                <p class="text-sm text-red-700">
                    <%= error %>
                </p>
            <% end %>
        </div>
    <% end %>

    <div class="border-b border-gray-200 px-4 py-3">
        <%= form.select :kind,
                        [
                            ["Reply", "reply"],
                            ["Internal note", "note"]
                        ],
                        {},
                        class: "rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm"%>
    </div>

    <div class="p-4">
        <%= form.rich_text_area :body,
                            rows: 5,
                            placeholder: "Write a reply...",
                            class: "block w-full resize-none border-0 p-0 text-sm text-gray-900 outline-none placeholder:text-gray-400 focus:ring-0"%>
    </div>

    <div class="flex justify-end border-t border-gray-200 px-4 py-3">
        <%= form.submit "Send", class: "cursor-pointer rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
    </div>

    <% end %>
</div>
