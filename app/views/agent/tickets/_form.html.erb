<%= form_with model: ticket do |form| %>
  <% if ticket.errors.any? %>
    <div class="mb-6 rounded-lg bg-red-50 p-4">
      <% ticket.errors.full_messages.each do |message| %>
        <p class="text-sm text-red-700">
          <%= message %>
        </p>
      <% end %>
    </div>
  <% end %>

  <div class="space-y-6">
    <div>
      <%= form.label :subject,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.text_field :subject,
                          class: "mt-2 block w-full rounded-lg border border-gray-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :status,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.select :status,
                      Ticket.statuses.keys.map { |status| [status.humanize, status] },
                      {},
                      class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2" %>
    </div>

    <div>
      <%= form.label :priority,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.select :priority,
                      Ticket.priorities.keys.map { |priority| [priority.humanize, priority] },
                      {},
                      class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2" %>
    </div>
  </div>

  <div class="mt-8">
    <%= form.submit "Save changes",
                    class: "cursor-pointer rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white" %>
  </div>
<% end %>