<%= turbo_frame_tag dom_id(ticket, :properties) do %>
  <div class="p-6">
    <h2 class="text-sm font-semibold text-gray-900">
      Properties
    </h2>

    <%= form_with model: [:agent, ticket], class: "mt-6 space-y-6" do |form| %>
      <div>
        <%= form.label :status,
          class: "block text-xs font-medium uppercase tracking-wide text-gray-500" %>

        <%= form.select :status,
          Ticket.statuses.keys.map { |status| [status.humanize, status] },
          {},
          class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900" %>
      </div>

      <div>
        <%= form.label :priority,
          class: "block text-xs font-medium uppercase tracking-wide text-gray-500" %>

        <%= form.select :priority,
          Ticket.priorities.keys.map { |priority| [priority.humanize, priority] },
          {},
          class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900" %>
      </div>

      <div>
        <%= form.label :assignee_id,
          "Assignee",
          class: "block text-xs font-medium uppercase tracking-wide text-gray-500" %>

        <%= form.collection_select :assignee_id,
          Current.account.users.order(:email_address),
          :id,
          :email_address,
          { include_blank: "Unassigned" },
          class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900" %>
      </div>

      <%= form.submit "Save changes",
        class: "w-full cursor-pointer rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
    <% end %>

    <div class="mt-8 border-t border-gray-200 pt-6">
      <p class="text-xs font-medium uppercase tracking-wide text-gray-500">
        Requester
      </p>

      <% if ticket.requester %>
        <p class="mt-2 text-sm font-medium text-gray-900">
          <%= ticket.requester.name.presence || "Customer" %>
        </p>

        <p class="text-sm text-gray-500">
          <%= ticket.requester.email %>
        </p>
      <% end %>
    </div>
  </div>
<% end %>
