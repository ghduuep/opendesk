<% content_for :title, "#{@ticket.subject} · OpenDesk" %>

<div class="flex min-h-screen">
    <section class="min-w-0 flex-1 border-r border-gray-200">
        <header class="border-b border-gray-200 bg-white px-8 py-6">
            <%= link_to "<- Tickets", agent_tickets_path, class: "text-sm text-gray-500 hover:text-gray-900" %>

            <div class="mt-4 flex items-start justify-between gap-4">
                <div>
                    <h1 class="text-xl font-semibold text-gray-900">
                        <%= @ticket.subject %>
                    </h1>

                    <p class="mt-1 text-sm text-gray-500">
                        <% if @ticket.requester %>
                            <%= @ticket.requester.name.presence || @ticket.requester.email %>
                        <% else %>
                            No requester
                        <% end %>
                    </p>
                </div>

                <%= button_to agent_ticket_path(@ticket), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this ticket?"}, class: "shrink-0 text-sm font-medium text-red-600 hover:text-red-700" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash preview-icon"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                <% end %>
            </div>
        </header>

        <div class="mx-auto max-w-3xl space-y-4 px-8 py-8">
            <div id="messages" class="space-y-4">
                <%= render @messages %>
            </div>

            <div id="new_message" class="pt-4">
                <%= render "agent/messages/form", ticket: @ticket, message: @message %>
            </div>
        </div>
    </section>

    <aside class="w-80 shrink-0 bg-white">
        <%= render "properties", ticket: @ticket %>
    </aside>
</div>
