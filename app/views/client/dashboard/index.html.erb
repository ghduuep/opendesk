<% content_for :title, "Dashboard · OpenDesk" %>

<div class="mx-auto max-w-6xl px-6 py-8">
  <div class="flex items-start justify-between gap-6">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">
        Dashboard
      </h1>

      <p class="mt-1 text-sm text-gray-500">
        Keep track of your support requests.
      </p>
    </div>

    <%= link_to new_client_ticket_path,
      class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" do %>
      New ticket
    <% end %>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm font-medium text-gray-500">
        Open
      </p>

      <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        <%= @open_tickets_count %>
      </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm font-medium text-gray-500">
        Waiting
      </p>

      <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        <%= @pending_tickets_count %>
      </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm font-medium text-gray-500">
        Resolved
      </p>

      <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        <%= @resolved_tickets_count %>
      </p>
    </div>
  </div>

  <section class="mt-8">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-base font-semibold text-gray-900">
          Recent tickets
        </h2>

        <p class="mt-1 text-sm text-gray-500">
          Your latest support requests.
        </p>
      </div>

      <%= link_to "View all",
        client_tickets_path,
        class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
    </div>

    <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 bg-white">
      <% if @recent_tickets.any? %>
        <div class="divide-y divide-gray-100">
          <% @recent_tickets.each do |ticket| %>
            <%= link_to client_ticket_path(ticket),
              class: "flex items-center justify-between gap-6 px-5 py-4 hover:bg-gray-50" do %>

              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-gray-900">
                  <%= ticket.subject %>
                </p>

                <p class="mt-1 text-xs text-gray-500">
                  Created <%= time_ago_in_words(ticket.created_at) %> ago
                </p>
              </div>

              <div class="flex shrink-0 items-center gap-4">
                <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">
                  <%= ticket.status.humanize %>
                </span>

                <span class="text-gray-400">
                  →
                </span>
              </div>

            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="px-6 py-12 text-center">
          <p class="text-sm font-medium text-gray-900">
            No tickets yet
          </p>

          <p class="mt-1 text-sm text-gray-500">
            When you need help, create your first support request.
          </p>

          <%= link_to "Create a ticket",
            new_client_ticket_path,
            class: "mt-4 inline-flex text-sm font-medium text-gray-900 hover:text-gray-600" %>
        </div>
      <% end %>
    </div>
  </section>
</div>
