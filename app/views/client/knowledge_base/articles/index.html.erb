<% content_for :title, "Search · Knowledge Base · OpenDesk" %>

<div class="mx-auto max-w-4xl px-6 py-10">
  <%= link_to "← Knowledge Base",
    client_knowledge_base_root_path,
    class: "text-sm text-gray-500 hover:text-gray-900" %>

  <header class="mt-6">
    <h1 class="text-2xl font-semibold text-gray-900">
      Search results
    </h1>

    <p class="mt-2 text-sm text-gray-500">
      Results for "<%= @query %>"
    </p>
  </header>

  <%= form_with url: client_knowledge_base_articles_path,
    method: :get,
    class: "mt-6" do |form| %>

    <div class="flex gap-2">
      <%= form.search_field :q,
        value: @query,
        class: "block w-full rounded-lg border border-gray-300 px-4 py-3 text-sm" %>

      <%= form.submit "Search",
        class: "rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white" %>
    </div>
  <% end %>

  <div class="mt-8">
    <% if @articles.any? %>
      <div class="divide-y divide-gray-100 rounded-xl border border-gray-200 bg-white">
        <% @articles.each do |article| %>
          <%= link_to client_knowledge_base_article_path(article),
            class: "block p-5 hover:bg-gray-50" do %>

            <p class="text-xs font-medium text-gray-500">
              <%= article.category.name %>
            </p>

            <h2 class="mt-1 font-medium text-gray-900">
              <%= article.title %>
            </h2>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-gray-300 p-10 text-center">
        <p class="text-sm text-gray-500">
          No articles found.
        </p>
      </div>
    <% end %>
  </div>
</div>
