<% content_for :title, "Knowledge Base · OpenDesk" %>

<div class="mx-auto max-w-5xl px-6 py-10">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900">
      Knowledge Base
    </h1>

    <p class="mt-2 text-sm text-gray-500">
      Find answers and helpful information.
    </p>
  </div>

  <%= form_with url: client_knowledge_base_search_path,
    method: :get,
    class: "mt-8" do |form| %>

    <div class="flex gap-2">
      <%= form.search_field :q,
        value: params[:q],
        placeholder: "Search the knowledge base...",
        class: "block w-full rounded-lg border border-gray-300 px-4 py-3 text-sm",
        required: true %>

      <%= form.submit "Search",
        class: "rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white hover:bg-gray-700" %>
    </div>
  <% end %>

  <div class="mt-8">
    <% if @categories.any? %>
      <div class="grid gap-4 sm:grid-cols-2">
        <% @categories.each do |category| %>
          <%= link_to client_knowledge_base_category_path(category),
            class: "rounded-xl border border-gray-200 bg-white p-5 transition hover:border-gray-300 hover:shadow-sm" do %>

            <h2 class="font-semibold text-gray-900">
              <%= category.name %>
            </h2>

            <% if category.description.present? %>
              <p class="mt-2 text-sm text-gray-500">
                <%= category.description %>
              </p>
            <% end %>

            <p class="mt-4 text-xs text-gray-400">
              <%= pluralize(category.articles.published.count, "article") %>
            </p>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-gray-300 px-6 py-12 text-center">
        <p class="text-sm text-gray-500">
          No articles available yet.
        </p>
      </div>
    <% end %>
  </div>
</div>
