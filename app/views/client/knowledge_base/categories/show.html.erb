<% content_for :title, "#{@category.name} · OpenDesk" %>

<div class="mx-auto max-w-4xl px-6 py-10">
  <%= link_to "← Knowledge Base",
    client_knowledge_base_root_path,
    class: "text-sm text-gray-500 hover:text-gray-900" %>

  <header class="mt-6">
    <h1 class="text-2xl font-semibold text-gray-900">
      <%= @category.name %>
    </h1>
  </header>

  <div class="mt-8">
    <% if @articles.any? %>
      <div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
        <div class="divide-y divide-gray-100">
          <% @articles.each do |article| %>
            <%= link_to client_knowledge_base_article_path(article),
              class: "block px-5 py-4 hover:bg-gray-50" do %>

              <h2 class="text-sm font-medium text-gray-900">
                <%= article.title %>
              </h2>

              <p class="mt-1 text-xs text-gray-400">
                View article →
              </p>

            <% end %>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-gray-300 px-6 py-12 text-center">
        <p class="text-sm text-gray-500">
          No articles available in this category.
        </p>
      </div>
    <% end %>
  </div>
</div>
