<% content_for :title, "My Tickets · OpenDesk" %>

<div class="mx-auto max-w-5xl px-6 py-8">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">
        My tickets
      </h1>

      <p class="mt-1 text-sm text-gray-500">
        View and manage your support requests.
      </p>
    </div>

    <%= link_to "New ticket",
      new_client_ticket_path,
      class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
  </div>

  <div class="mt-8">
    <% if @tickets.any? %>
      <div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
        <div class="divide-y divide-gray-100">
          <% @tickets.each do |ticket| %>
            <%= link_to client_ticket_path(ticket),
              class: "block px-5 py-4 hover:bg-gray-50" do %>

              <div class="flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-gray-900">
                    <%= ticket.subject %>
                  </p>

                  <p class="mt-1 text-xs text-gray-500">
                    Created <%= time_ago_in_words(ticket.created_at) %> ago
                  </p>
                </div>

                <span class="text-xs font-medium text-gray-500">
                  <%= ticket.status.humanize %>
                </span>
              </div>

            <% end %>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-gray-300 px-6 py-12 text-center">
        <h2 class="text-sm font-semibold text-gray-900">
          No tickets yet
        </h2>

        <p class="mt-1 text-sm text-gray-500">
          When you contact support, your tickets will appear here.
        </p>
      </div>
    <% end %>
  </div>
</div>
