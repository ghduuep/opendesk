<% content_for :title, "New Ticket · OpenDesk" %>

<div class="mx-auto max-w-3xl px-6 py-8">
  <%= link_to "← My tickets",
    client_tickets_path,
    class: "text-sm text-gray-500 hover:text-gray-900" %>

  <div class="mt-6">
    <h1 class="text-2xl font-semibold text-gray-900">
      Create a ticket
    </h1>

    <p class="mt-1 text-sm text-gray-500">
      Tell us how we can help.
    </p>
  </div>

  <%= form_with model: @ticket_form,
    url: client_tickets_path,
    class: "mt-8 space-y-6" do |form| %>

    <% if @ticket_form.errors.any? %>
      <div class="rounded-lg bg-red-50 p-4 text-sm text-red-700">
        <% @ticket_form.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= form.label :subject,
        class: "block text-sm font-medium text-gray-700" %>

      <%= form.text_field :subject,
        autofocus: true,
        class: "mt-2 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= form.label :message_body, "How can we help?",
        class: "block text-sm font-medium text-gray-700" %>

      <%= form.rich_text_area :message_body,
        class: "mt-2" %>
    </div>

    <div class="flex justify-end">
      <%= form.submit "Create ticket",
        class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
    </div>
  <% end %>
</div>
