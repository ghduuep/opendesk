<% content_for :title, "#{@ticket.subject} · OpenDesk" %>

<div class="mx-auto max-w-4xl px-6 py-8">
  <%= link_to "← My tickets",
    client_tickets_path,
    class: "text-sm text-gray-500 hover:text-gray-900" %>

  <header class="mt-6 border-b border-gray-200 pb-6">
    <div class="flex items-start justify-between gap-6">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900">
          <%= @ticket.subject %>
        </h1>

        <p class="mt-2 text-sm text-gray-500">
          Created <%= time_ago_in_words(@ticket.created_at) %> ago
        </p>
      </div>

      <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600">
        <%= @ticket.status.humanize %>
      </span>
    </div>
  </header>

  <div class="mt-8 space-y-6">
    <% if @ticket.description.present? %>
      <div class="rounded-xl border border-gray-200 bg-white p-5">
        <div class="prose prose-sm max-w-none">
          <%= @ticket.description %>
        </div>
      </div>
    <% end %>

    <div class="space-y-4">
      <% @messages.each do |message| %>
        <%= render "client/messages/message", message: message %>
      <% end %>
    </div>

    <div class="mt-8 border-t border-gray-200 pt-6">
      <h2 class="text-sm font-semibold text-gray-900">
        Reply
      </h2>

      <%= form_with model: [ :client, @ticket, @message ],
        class: "mt-4 space-y-4" do |form| %>

        <% if @message.errors.any? %>
          <div class="rounded-lg bg-red-50 p-4 text-sm text-red-700">
              <% messages.errors.full_messages.each do |message| %>
                <p><%= message %></p>
              <% end %>
          </div>
        <% end %>

        <div>
          <%= form.rich_text_area :body %>
        </div>

        <div class="flex justify-end">
          <%= form.submit "Send reply",
            class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
