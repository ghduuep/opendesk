<% content_for :title, "Contacts · OpenDesk" %>

<div class="px-8 py-8">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight text-gray-900">
            Contacts
        </h1>

        <p class="mt-1 text-sm text-gray-500">
            Customers who have contacted your support team.
        </p>
    </div>

    <div class="mt-8 overflow-hidden rounded-xl border boder-gray-200 bg-white shadow-sm">
        <% if @contacts.any? %>
            <div class="grid grid-cols-[1fr_1fr_120px] border-b border-gray-200 bg-gray-50 px-5 py-3 text-xs font-medium uppercase tracking-wide text-gray-500">
                <div>Name</div>
                <div>Email</div>
                <div>Tickets</div>
            </div>

            <div class="divide-y divide-gray-100">
                <% @contacts.each do |contact| %>
                    <%= link_to contact,
                      class: "grid grid-cols-[1fr_1fr_120px] items-center px-5 py-4 hover:bg-gray-50" do %>

                    <div class="min-w-0 pr-4">
                    <p class="truncate text-sm font-medium text-gray-900">
                        <%= contact.name.presence || "Unnamed contact" %>
                    </p>
                    </div>

                    <div class="min-w-0 pr-4">
                    <p class="truncate text-sm text-gray-500">
                        <%= contact.email %>
                    </p>
                    </div>

                    <div class="text-sm text-gray-500">
                    <%= contact.tickets.size %>
                    </div>

                    <% end %>
                <% end %>
            </div>

            <% else %>
                <div class="px-6 py-20 text-center">
                    <h2 class="text-sm font-semibold text-gray-900">
                        No contacts yet
                    </h2>

                    <p class="mt-1 text-sm text-gray-500">
                        Contacts are created automatically when you create tickets.
                    </p>

                    <%= link_to "Create a ticket",
                                new_ticket_path,
                                class: "mt-5 inline-flex rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
                </div>
            <% end %>
    </div>
</div>