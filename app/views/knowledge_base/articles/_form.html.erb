<%= form_with model: article,
  url: article.persisted? ?
    knowledge_base_article_path(article) :
    knowledge_base_category_articles_path(category),
  class: "space-y-6" do |form| %>

  <% if article.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-sm text-red-700">
      <%= article.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= form.label :title,
      class: "block text-sm font-medium text-gray-700" %>

    <%= form.text_field :title,
      autofocus: true,
      class: "mt-2 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= form.label :body, "Content",
      class: "block text-sm font-medium text-gray-700" %>

    <%= form.text_area :body,
      rows: 16,
      class: "mt-2 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= form.label :status,
      class: "block text-sm font-medium text-gray-700" %>

    <%= form.select :status,
      KnowledgeBase::Article.statuses.keys.map { |status| [status.humanize, status] },
      {},
      class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm" %>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancel",
      article.persisted? ?
        knowledge_base_article_path(article) :
        knowledge_base_category_path(category),
      class: "text-sm text-gray-600 hover:text-gray-900" %>

    <%= form.submit article.persisted? ? "Save changes" : "Create article",
      class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
  </div>
<% end %>