<% content_for :title, "New article · OpenDesk" %>

<div class="mx-auto max-w-3xl px-8 py-10">
  <%= link_to "← #{@category.name}",
    knowledge_base_category_path(@category),
    class: "text-sm text-gray-500 hover:text-gray-900" %>

  <div class="mt-6">
    <h1 class="text-2xl font-semibold text-gray-900">
      New article
    </h1>

    <p class="mt-1 text-sm text-gray-500">
      Create an article in <%= @category.name %>.
    </p>
  </div>

  <div class="mt-8">
    <%= render "form",
      article: @article,
      category: @category %>
  </div>
</div>