<div class="mx-auto max-w-5xl px-6 py-10">
  <h1 class="text-2xl font-semibold text-gray-900">
    Search
  </h1>

  <%= form_with url: search_path, method: :get, class: "mt-6" do |form| %>
    <%= form.search_field :q,
      value: @query,
      placeholder: "Search...",
      autofocus: true,
      class: "w-full rounded-lg border border-gray-300 px-4 py-3" %>
  <% end %>

  <% if @query.blank? %>
    <p class="mt-8 text-sm text-gray-500">
      Enter a term to search.
    </p>
  <% else %>
    <div class="mt-8 space-y-8">
      <% if @results[:tickets].any? %>
        <section>
          <h2 class="text-lg font-semibold">Tickets</h2>

          <div class="mt-3 space-y-2">
            <% @results[:tickets].each do |ticket| %>
              <%= link_to( Current.user.customer? ? client_ticket_path(ticket) : agent_ticket_path(ticket), class: "block rounded-lg border border-gray-200 p-4 hover:bg-gray-50") do %>
                <p class="font-medium"><%= ticket.subject %></p>
                <p class="text-sm text-gray-500">Ticket #<%= ticket.id %></p>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @results[:contacts].any? %>
        <section>
          <h2 class="text-lg font-semibold">Contacts</h2>

          <div class="mt-3 space-y-2">
            <% @results[:contacts].each do |contact| %>
              <%= link_to agent_contact_path(contact), class:"rounded-lg border border-gray-200 p-4" do %>
                <p class="font-medium"><%= contact.display_name %></p>
                <p class="text-sm text-gray-500"><%= contact.email %></p>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @results[:articles].any? %>
        <section>
          <h2 class="text-lg font-semibold">Articles</h2>

          <div class="mt-3 space-y-2">
            <% @results[:articles].each do |article| %>
              <%= link_to( Current.user.customer? ? client_knowledge_base_article_path(article) : agent_knowledge_base_article_path(article), class:"block rounded-lg border border-gray-200 p-4 hover:bg-gray-50") do %>
                <p class="font-medium"><%= article.title %></p>
                <p class="text-sm text-gray-500"><%= article.category.name %></p>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @results[:users].any? %>
        <section>
          <h2 class="text-lg font-semibold">Users</h2>

          <div class="mt-3 space-y-2">
            <% @results[:users].each do |user| %>
              <%= link_to admin_user_path(user), class:"block rounded-lg border border-gray-200 p-4 hover:bg-gray-50" do %>
                <p class="font-medium"><%= user.email_address %></p>
                <p class="text-sm text-gray-500"><%= user.role %></p>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
