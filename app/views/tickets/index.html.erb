<% content_for :title, "Tickets · OpenDesk" %>

<div class="px-8 py-8">
  <div class="flex items-start justify-between">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-gray-900">
        Tickets
      </h1>

      <p class="mt-1 text-sm text-gray-500">Manage customer support requests.</p>
    </div>

    <%= link_to "New ticket", new_ticket_path, class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-gray-700"%>
  </div>

  <div class="mt-6 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
  <%= form_with url: tickets_path,
                method: :get,
                class: "flex flex-wrap items-end gap-3" do |form| %>

    <div class="min-w-64 flex-1">
      <%= form.label :q,
                     "Search",
                     class: "block text-xs font-medium text-gray-500" %>

      <%= form.search_field :q,
                            value: params[:q],
                            placeholder: "Search tickets...",
                            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= form.label :status,
                     class: "block text-xs font-medium text-gray-500" %>

      <%= form.select :status,
                      Ticket.statuses.keys.map { |status| [status.humanize, status] },
                      {
                        include_blank: "All statuses",
                        selected: params[:status]
                      },
                      class: "mt-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= form.label :priority,
                     class: "block text-xs font-medium text-gray-500" %>

      <%= form.select :priority,
                      Ticket.priorities.keys.map { |priority| [priority.humanize, priority] },
                      {
                        include_blank: "All priorities",
                        selected: params[:priority]
                      },
                      class: "mt-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= form.label :assignee_id,
                     "Assignee",
                     class: "block text-xs font-medium text-gray-500" %>

      <%= form.select :assignee_id,
                      [
                        ["Unassigned", "unassigned"]
                      ] + Current.account.users.order(:email_address).map { |user|
                        [user.email_address, user.id]
                      },
                      {
                        include_blank: "All assignees",
                        selected: params[:assignee_id]
                      },
                      class: "mt-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm" %>
    </div>

    <%= form.submit "Filter",
                    class: "cursor-pointer rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>

    <% if params.values_at(:q, :status, :priority, :assignee_id).any?(&:present?) %>
      <%= link_to "Clear",
                  tickets_path,
                  class: "rounded-lg px-4 py-2 text-sm font-medium text-gray-500 hover:bg-gray-100 hover:text-gray-900" %>
    <% end %>

  <% end %>
</div>

  <div class="mt-6">
    <%= render "list", tickets: @tickets %>
  </div>
</div>