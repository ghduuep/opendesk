<% content_for :title, "New ticket · OpenDesk" %>

<div class="mx-auto max-w-3xl px-8 py-10">
  <div>
    <%= link_to "← Tickets",
                tickets_path,
                class: "text-sm text-gray-500 hover:text-gray-900" %>

    <h1 class="mt-4 text-2xl font-semibold tracking-tight text-gray-900">
      New ticket
    </h1>

    <p class="mt-1 text-sm text-gray-500">
      Create a new customer support request.
    </p>
  </div>

  <div class="mt-8 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <%= form_with model: @ticket_form, url: tickets_path do |form| %>

      <% if @ticket_form.errors.any? %>
        <div class="mb-6 rounded-lg bg-red-50 p-4">
          <% @ticket_form.errors.full_messages.each do |message| %>
            <p class="text-sm text-red-700">
              <%= message %>
            </p>
          <% end %>
        </div>
      <% end %>

      <div class="space-y-6">
        <div>
          <%= form.label :requester_name,
                         "Requester name",
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.text_field :requester_name,
                              placeholder: "John Doe",
                              class: "mt-2 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= form.label :requester_email,
                         "Requester email",
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.email_field :requester_email,
                               placeholder: "john@example.com",
                               class: "mt-2 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= form.label :subject,
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.text_field :subject,
                              placeholder: "How can we help?",
                              class: "mt-2 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= form.label :priority,
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.select :priority,
                          Ticket.priorities.keys.map { |priority| [priority.humanize, priority] },
                          {},
                          class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= form.label :message_body,
                         "Message",
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.text_area :message_body,
                             rows: 8,
                             placeholder: "Describe the customer's issue...",
                             class: "mt-2 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
        </div>
      </div>

      <div class="mt-8 flex justify-end gap-3">
        <%= link_to "Cancel",
                    tickets_path,
                    class: "rounded-lg px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-100" %>

        <%= form.submit "Create ticket",
                        class: "cursor-pointer rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
      </div>

    <% end %>
  </div>
</div>