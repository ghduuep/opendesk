<% content_for :title, "#{@ticket.subject} · OpenDesk" %>

<div class="flex min-h-screen">
    <section class="min-w-0 flex-1 border-r border-gray-200">
        <header class="border-b border-gray-200 bg-white px-8 py-6">
            <%= link_to "<- Tickets", tickets_path, class: "text-sm text-gray-500 hover:text-gray-900" %>

            <div class="mt-4">
                <h1 class="text-xl font-semibold text-gray-900">
                    <%= @ticket.subject %>
                </h1>

                <p class="mt-1 text-sm text-gray-500">
                    <% if @ticket.requester %>
                        <%= @ticket.requester.name.presence || @ticket.requester.email %>
                    <% else %>
                        No requester
                    <% end %>
                </p>
            </div>
        </header>

        <div class="mx-auto max-w-3xl space-y-4 px-8 py-8">
            <div id="messages" class="space-y-4">
                <%= render @messages %>
            </div>

            <div id="new_message" class="pt-4">
                <%= render "messages/form", ticket: @ticket, message: @message %>
            </div>
        </div>
    </section>

    <aside class="w-80 shrink-0 bg-white">
        <%= render "properties", ticket: @ticket %>
    </aside>
</div>